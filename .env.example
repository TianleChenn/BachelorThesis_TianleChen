# Cloud models (optional)
OPENAI_API_KEY=
LLM_STRONG_MODEL=gpt-4.1
PRIVACY_RISK_CACHE_ENABLED=true

# Cloud code-generation benchmark
EVAL_OPENAI_MODEL=gpt-4.1
EVAL_GEMINI_MODEL=gemini-3.5-flash
LLM_GEMINI_MODEL=gemini-3.5-flash
LLM_GEMINI_PROVIDER=openai_compatible
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=
EVAL_CLAUDE_MODEL=claude-sonnet-5
LLM_CLAUDE_MODEL=claude-sonnet-5
LLM_CLAUDE_BASE_URL=https://api.anthropic.com/v1/
LLM_CLAUDE_API_KEY=

# Local model for high-privacy requests
LLM_LOCAL_PROVIDER=openai_compatible
LLM_LOCAL_MODEL=Ministral-3-8B-Local
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_API_KEY=
LLM_LOCAL_MAX_NEW_TOKENS=256
LLM_LOCAL_TEMPERATURE=0
LLM_LOCAL_DO_SAMPLE=0
LLM_ALLOW_CLOUD_FOR_HIGH_RISK=0
