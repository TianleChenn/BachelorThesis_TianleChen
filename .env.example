# Public environment template. Copy this file to .env for local development.
# Keep every API key blank here and never commit the local .env file.

# OpenAI privacy assessor
OPENAI_API_KEY=
LLM_STRONG_MODEL=gpt-4.1

# Legacy / optional evaluation configuration
LLM_PRIVACY_DATASET_MODEL=gpt-5.4-nano
LLM_WEAK_MODEL=Ministral-3-8B
LLM_WEAK_PROVIDER=openai_compatible
LLM_WEAK_PROVIDER_MODEL_ID=ministral-8b-latest
LLM_WEAK_BASE_URL=https://api.mistral.ai/v1
LLM_WEAK_API_KEY=
ROUTELLM_CPT_TARGET=0.75
LLM_JUDGE_MODEL=gpt-4o-mini

# Privacy routing
PRIVACY_RISK_CACHE_ENABLED=true

# Gemini cloud model
LLM_GEMINI_PROVIDER=openai_compatible
LLM_GEMINI_MODEL=gemini-3.5-flash
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=

# Claude cloud model
LLM_CLAUDE_PROVIDER=openai_compatible
LLM_CLAUDE_MODEL=claude-sonnet-5
LLM_CLAUDE_BASE_URL=https://api.anthropic.com/v1/
LLM_CLAUDE_API_KEY=

# Local OpenAI-compatible model
LLM_LOCAL_PROVIDER=openai_compatible
LLM_LOCAL_MODEL=Ministral-3-8B-Local
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_API_KEY=none

# Optional runtime and evaluation overrides
LLM_LOCAL_DEVICE=auto
LLM_LOCAL_MAX_NEW_TOKENS=256
LLM_LOCAL_MODEL_ID=
LLM_PRIVACY_GATER_MODEL_PATH=
LLAMA_SERVER_PATH=
EVAL_OPENAI_MODEL=gpt-4.1
OPENAI_STRONG_MODEL=gpt-4.1
EVAL_GEMINI_MODEL=gemini-3.5-flash
EVAL_CLAUDE_MODEL=claude-sonnet-5
